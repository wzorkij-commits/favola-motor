# Модели
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_RU=

# Полка и оплаченное. Без этих двух всё работает, но ничего не переживает
# перезапуск: хранилище становится памятью процесса.
# Завести: Vercel -> Storage -> Upstash Redis, ключи придут сами. У Vercel они
# называются KV_REST_API_URL и KV_REST_API_TOKEN, код понимает оба названия.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Оплата. Ключ берётся в личном кабинете SumUp.
# Для тестов там же заводится ОТДЕЛЬНЫЙ песочный продавец:
# его транзакции ненастоящие, деньги не ходят.
SUMUP_API_KEY=
SUMUP_MERCHANT_CODE=

# Вход через Google. Заводится в Google Cloud Console:
# APIs & Services -> Credentials -> Create credentials -> OAuth client ID
# -> Web application. В Authorized JavaScript origins вписать адрес сайта,
# например https://favola-vercel-1.vercel.app
# Сюда кладётся Client ID (он публичный, секрет не нужен).
GOOGLE_CLIENT_ID=

# Письма: код для входа и чек об оплате. resend.com, бесплатный тариф.
RESEND_API_KEY=
MAIL_FROM=Favola <onboarding@resend.dev>

# Файлы сказок: картинки и озвучка.
# Vercel -> Storage -> Create Database -> Blob. Ключ пропишется сам.
BLOB_READ_WRITE_TOKEN=

# Необязательное.
# Почты владельца (через запятую): безлимит без оплаты. Почта Василия зашита в lib/owner.js.
# OWNER_EMAILS=
# Названия моделей и голоса, если нужно заменить умолчания.
# FAVOLA_TEXT_MODEL=
# FAVOLA_IMAGE_MODEL=
# FAVOLA_VOICE_MODEL=
# FAVOLA_STT_MODEL=
# ELEVENLABS_VOICE_EN=
